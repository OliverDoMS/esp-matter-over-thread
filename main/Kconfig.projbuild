menu "DoNetIoT base system"
    config BASE_DIAGNOSTIC_NO_SLEEP
        bool "Diagnostic firmware: disable automatic Light-sleep"
        default n
        help
            Use temporarily to investigate native USB disconnects. This disables
            automatic Light-sleep regardless of USB connection detection and
            increases current consumption. Not for battery measurements.

    config BASE_NODE_LABEL
        string "Matter node label (maximum 32 bytes)"
        default "DoNetIoT Bodenfeuchte 3"

    config BASE_BUTTON_GPIO
        int "Service button GPIO (active low)"
        range 9 14
        default 9
        help
            GPIO9 is the BOOT button on the documented H2 Super Mini layout.
            Do not hold BOOT during reset unless entering the ROM downloader.

    config BASE_DISABLE_SUPERMINI_LEDS
        bool "Turn off GPIO13 LED and clear GPIO8 WS2812 at startup"
        default y
        help
            For the Super Mini layout shown in this repository only.
            Clearing an LED does not remove its electrical standby current.

    config BASE_TEST_CONTACT
        bool "Create a virtual contact sensor for initial commissioning tests"
        depends on !BASE_SOIL_MOISTURE
        default n
        help
            A short button press toggles this TEST contact. No physical sensor
            is read. Add real sensor endpoints in sensors.cpp in later variants.

    config BASE_SOIL_MOISTURE
        bool "Three analog capacitive soil moisture sensors"
        default y
        help
            Each sensor: VCC to its supply GPIO (HIGH only while measured),
            AOUT to its ADC GPIO, GND to GND. Sensors are read one after another.
            Calibrate dry and wet per sensor over Matter before percentages appear.
            Avoid GPIO2 and GPIO3 (strapping pins) for AOUT.

    config BASE_SOIL_1_ADC_GPIO
        int "Sensor 1 AOUT GPIO (H2 ADC1)"
        depends on BASE_SOIL_MOISTURE
        range 1 5
        default 4

    config BASE_SOIL_1_POWER_GPIO
        int "Sensor 1 VCC GPIO"
        depends on BASE_SOIL_MOISTURE
        range 0 14
        default 10

    config BASE_SOIL_2_ADC_GPIO
        int "Sensor 2 AOUT GPIO (H2 ADC1)"
        depends on BASE_SOIL_MOISTURE
        range 1 5
        default 5

    config BASE_SOIL_2_POWER_GPIO
        int "Sensor 2 VCC GPIO"
        depends on BASE_SOIL_MOISTURE
        range 0 14
        default 11

    config BASE_SOIL_3_ADC_GPIO
        int "Sensor 3 AOUT GPIO (H2 ADC1)"
        depends on BASE_SOIL_MOISTURE
        range 1 5
        default 1

    config BASE_SOIL_3_POWER_GPIO
        int "Sensor 3 VCC GPIO"
        depends on BASE_SOIL_MOISTURE
        range 0 14
        default 12

    config BASE_SOIL_CONNECTION_CHECK
        bool "Report a sensor as unknown when AOUT is not driven by a sensor"
        depends on BASE_SOIL_MOISTURE
        default y
        help
            Reads AOUT with the internal pulldown before and after power on.
            Disable only if a connected sensor is rejected by mistake.

    config BASE_BUTTON_LED_FEEDBACK
        bool "Show the BOOT reset selection on the blue GPIO13 LED"
        depends on BASE_SOIL_MOISTURE && BASE_DISABLE_SUPERMINI_LEDS
        default y
        help
            Rapid blinking after 10 s selects Matter reset. Release BOOT to
            execute. GPIO13 must not be used as the service button.

    config BASE_SOIL_SETTLE_MS
        int "Sensor settling time after power on (milliseconds)"
        depends on BASE_SOIL_MOISTURE
        range 50 5000
        default 500
endmenu
